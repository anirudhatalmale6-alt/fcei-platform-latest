# FCEI platform environment — copy to ".env" and fill in real values.
# The real production values live in the server's own .env at
# /var/www/fcei.eu/platform/fcei_platform/.env  — they are NOT shipped in this
# package for security (live Stripe keys, etc.).

# Server
PORT=8787
SITE_URL=https://fcei.eu/platform

# Stripe (LIVE keys — never commit these)
STRIPE_SECRET_KEY=sk_live_xxx_or_restricted_rk_live_xxx
STRIPE_RESTRICTED_KEY=rk_live_xxx

# Transactional email
FROM_EMAIL=no-reply@fcei.eu
NOTIFY_EMAIL=admin@fcei.eu
